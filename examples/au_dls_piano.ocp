// AudioUnit offline render — macOS ships this instrument (CoreAudio.component).
// `ocp render examples/au_dls_piano.ocp --output /tmp/au-dls.wav --report`
// prints a non-silent level report; nothing needs to be installed.
@ocp "0.2.0"

@project "AU DLS piano"
  tempo: 120
  time_signature: 4/4
  key: C major

@preset dls_piano
  source: au
  plugin: "Apple: DLSMusicDevice"

@track keys | preset: dls_piano, instrument: keys/piano
  @phrase motif [1:1:0 - 3:1:0]
    C4  q  mf
    E4  q  mf
    G4  q  mf
    C5  h  f

@master
  effects:
    - limiter: ceiling=-0.3dB
