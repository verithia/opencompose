{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "OpenCompose",
  "scopeName": "source.ocp",
  "fileTypes": ["ocp"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#properties" },
    { "include": "#preset-source" },
    { "include": "#strings" },
    { "include": "#pitches" },
    { "include": "#durations" },
    { "include": "#dynamics" },
    { "include": "#articulations" },
    { "include": "#modifiers" },
    { "include": "#numbers" },
    { "include": "#barline" },
    { "include": "#drums" },
    { "include": "#rest" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "match": "//.*$",
      "name": "comment.line.double-slash.ocp"
    },
    "keywords": {
      "match": "@(control_source|vocal_harmony|control_link|audio_clip|vocal_tune|pattern|project|section|marker|master|phrase|preset|grace|group|track|bus|kit|ocp)\\b",
      "name": "keyword.control.ocp"
    },
    "properties": {
      "match": "\\b(tempo|time_signature|key|swing|instrument|engine|mix|effects|routes|automation|loudness|repeat|label|engine_params|preset|source|plugin|program|patch|file|root_note|params):",
      "name": "support.type.property-name.ocp"
    },
    "preset-source": {
      "match": "\\b(soundfont|clap|vst3|builtin|sample)\\b",
      "name": "constant.language.source.ocp"
    },
    "strings": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.ocp",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.ocp"
        }
      ]
    },
    "pitches": {
      "match": "\\b([A-G])(##?|bb?)?([0-9])\\b",
      "name": "constant.other.pitch.ocp",
      "captures": {
        "1": { "name": "constant.other.pitch.note.ocp" },
        "2": { "name": "constant.other.pitch.accidental.ocp" },
        "3": { "name": "constant.numeric.pitch.octave.ocp" }
      }
    },
    "durations": {
      "match": "\\b(w|h|q|8th|16th|32nd|64th)(\\.{1,2})?(t)?(~(w|h|q|8th|16th|32nd|64th))?\\b",
      "name": "constant.other.duration.ocp"
    },
    "dynamics": {
      "match": "(?<=\\s|^)(ppp|pp|mp|mf|fff|ff|p|f)(?=\\s|$)",
      "name": "entity.name.tag.dynamics.ocp"
    },
    "articulations": {
      "match": "\\b(staccatissimo|staccato|sul_ponticello|sul_tasto|flutter_tongue|col_legno|ghost_note|rim_shot|hammer_on|pull_off|palm_mute|legato|tenuto|marcato|accent|pizzicato|arco|tremolo|trill|harmonics|muted|open|sforzando|slide|bend|flam|roll|sustained|detached)\\b",
      "name": "variable.other.articulation.ocp"
    },
    "modifiers": {
      "match": "\\b(articulation|vibrato|expression|send|vol|pan|mute|solo)\\b",
      "name": "variable.parameter.modifier.ocp"
    },
    "numbers": {
      "patterns": [
        {
          "match": "[+-]?\\d+(\\.\\d+)?dB",
          "name": "constant.numeric.db.ocp"
        },
        {
          "match": "\\d+(\\.\\d+)?%",
          "name": "constant.numeric.percentage.ocp"
        },
        {
          "match": "\\d+(\\.\\d+)?Hz",
          "name": "constant.numeric.frequency.ocp"
        },
        {
          "match": "\\d+(\\.\\d+)?(ms|s|ct)",
          "name": "constant.numeric.unit.ocp"
        },
        {
          "match": "\\d+/\\d+",
          "name": "constant.numeric.time-sig.ocp"
        },
        {
          "match": "x\\d+",
          "name": "constant.numeric.repeat.ocp"
        },
        {
          "match": "\\d+:\\d+(:\\d+)?",
          "name": "constant.numeric.position.ocp"
        },
        {
          "match": "[+-]?\\d+(\\.\\d+)?",
          "name": "constant.numeric.ocp"
        }
      ]
    },
    "barline": {
      "match": "^\\s*\\|\\s*$",
      "name": "punctuation.separator.barline.ocp"
    },
    "drums": {
      "match": "\\b(kick|snare|hihat|crash|ride|splash|china|tom_high|tom_mid|tom_low|cowbell|clap|rim|shaker|tambourine|cabasa|guiro|woodblock|conga_high|conga_low|bongo_high|bongo_low)\\b",
      "name": "entity.name.function.drum.ocp"
    },
    "rest": {
      "match": "\\brest\\b",
      "name": "keyword.other.rest.ocp"
    },
    "operators": {
      "match": "(->|\\||=)",
      "name": "keyword.operator.ocp"
    },
    "identifiers": {
      "match": "\\b[a-z_][a-z0-9_]*(/[a-z_][a-z0-9_]*)?\\b",
      "name": "variable.other.ocp"
    }
  }
}
