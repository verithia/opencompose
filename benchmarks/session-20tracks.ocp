// OpenCompose performance reference session.
// 20 tracks, 32 bars at 120 BPM, fixed 4/4, no plugins and no outside assets.
// Eight OpenSynth tracks exercise unison, wavetable, filter and preset FX; eight
// SoundFont tracks use GM programs; four sampler tracks use @kit drum kits.
// Sampler pads read the checked-in test tone at
// crates/oc-engine/tests/fixtures/sampler/tone.flac, so the checkout is enough.
//
// Render with:
//   target/release/ocp render benchmarks/session-20tracks.ocp \
//     --output /tmp/perf.wav --soundfont <gm-bank.sf2> \
//     --sample-rate 48000 --no-loudness-normalisation
//   Any General MIDI bank works; the bundled FluidR3Mono_GM.sf3 is suitable.
//   scripts/perf/render_bench.sh          # the gated measurement
//
// The stage table, the throughput measurements and the remaining floor are in
// docs/performance-targets.md.

@ocp "0.2.0"

@project "Performance Reference 20T"
  tempo: 120
  time_signature: 4/4
  key: C minor

// ---------------------------------------------------------------------------
// OpenSynth patches
// ---------------------------------------------------------------------------

@preset synth_pad
  source: builtin
  plugin: "builtin.open_synth"
  params: {synth_version: 2, osc.a.waveform: 4, osc.a.wavetable_position: 0.58, osc.a.level: 0.55, osc.a.warp_mode: 2, osc.a.warp_amount: 0.35, osc.b.waveform: 0, osc.b.level: 0.28, osc.b.semitones: 12, noise.level: 0.03, unison.voices: 2, unison.detune: 10ct, unison.width: 0.7, filter.model: 1, filter.cutoff: 2800Hz, filter.resonance: 0.28, filter.env.amount: 1.8, filter_env.attack: 0.45s, filter_env.decay: 1.2s, filter_env.sustain: 0.6, filter_env.release: 1.5s, amp.attack: 0.65s, amp.decay: 1.4s, amp.sustain: 0.78, amp.release: 1.8s, voice.polyphony: 8, quality.oversampling: 1, output.gain: 0.2}
  effects:
    - chorus: rate=0.28, depth=4.2, mix=24%

@preset synth_lead
  source: builtin
  plugin: "builtin.open_synth"
  params: {synth_version: 2, osc.a.waveform: 1, osc.a.level: 0.62, osc.b.waveform: 2, osc.b.level: 0.18, osc.b.semitones: -12, osc.b.unison: 2, osc.b.detune: 8ct, osc.b.width: 0.4, unison.voices: 1, unison.detune: 6ct, unison.width: 0.5, filter.model: 1, filter.cutoff: 2100Hz, filter.resonance: 0.38, filter.drive: 0.15, filter.env.amount: 3.6, filter_env.attack: 0.005s, filter_env.decay: 0.28s, filter_env.sustain: 0.35, filter_env.release: 0.3s, amp.attack: 0.008s, amp.decay: 0.35s, amp.sustain: 0.55, amp.release: 0.4s, lfo.sync: true, lfo.division: 3, mod.1.source: 0, mod.1.destination: 4, mod.1.amount: 0.12, voice.polyphony: 6, quality.oversampling: 1, output.gain: 0.22}
  effects:
    - delay: time_l=330ms, time_r=495ms, feedback=26%, mix=16%

@preset synth_bass
  source: builtin
  plugin: "builtin.open_synth"
  params: {synth_version: 2, osc.a.waveform: 1, osc.a.level: 0.7, osc.b.waveform: 2, osc.b.level: 0.2, osc.b.semitones: -12, sub.level: 0.45, sub.semitones: -12, filter.model: 2, filter.cutoff: 640Hz, filter.resonance: 0.32, filter.drive: 0.4, filter.env.amount: 3.2, filter_env.attack: 0.003s, filter_env.decay: 0.2s, filter_env.sustain: 0.15, filter_env.release: 0.18s, amp.attack: 0.004s, amp.decay: 0.22s, amp.sustain: 0.5, amp.release: 0.12s, voice.mono: true, voice.legato: true, voice.glide: 0.06s, voice.polyphony: 1, quality.oversampling: 1, output.gain: 0.26}
  effects:
    - saturator: drive=16%, mix=28%

@preset synth_pluck
  source: builtin
  plugin: "builtin.open_synth"
  params: {synth_version: 2, osc.a.waveform: 2, osc.a.level: 0.62, osc.a.pulse_width: 0.32, osc.b.waveform: 1, osc.b.level: 0.2, osc.b.semitones: 12, unison.voices: 1, unison.detune: 4ct, filter.model: 0, filter.cutoff: 2600Hz, filter.resonance: 0.42, filter.env.amount: 4.2, filter_env.attack: 0s, filter_env.decay: 0.16s, filter_env.sustain: 0, filter_env.release: 0.12s, amp.attack: 0s, amp.decay: 0.2s, amp.sustain: 0.08, amp.release: 0.22s, voice.polyphony: 8, quality.oversampling: 1, output.gain: 0.24}
  effects:
    - chorus: rate=0.42, depth=3.5, mix=18%

@preset synth_keys
  source: builtin
  plugin: "builtin.open_synth"
  params: {synth_version: 2, osc.a.waveform: 4, osc.a.wavetable_position: 0.32, osc.a.level: 0.55, osc.a.warp_mode: 6, osc.a.warp_amount: 0.2, osc.b.waveform: 0, osc.b.level: 0.3, osc.b.semitones: 12, sub.level: 0.15, unison.voices: 1, unison.detune: 4ct, filter.model: 0, filter.cutoff: 3600Hz, filter.resonance: 0.22, filter.env.amount: 1.5, amp.attack: 0.01s, amp.decay: 0.6s, amp.sustain: 0.55, amp.release: 0.9s, voice.polyphony: 8, quality.oversampling: 1, output.gain: 0.2}
  effects:
    - eq: low_freq=160Hz, low_gain=-1.5dB, mid_freq=1000Hz, mid_gain=1.5dB, q=1.0, high_freq=8000Hz, high_gain=-1dB

@preset synth_arp
  source: builtin
  plugin: "builtin.open_synth"
  params: {synth_version: 2, osc.a.waveform: 2, osc.a.level: 0.5, osc.b.waveform: 4, osc.b.wavetable_position: 0.7, osc.b.level: 0.3, osc.b.semitones: 12, osc.b.unison: 1, osc.b.detune: 4ct, unison.voices: 1, unison.detune: 4ct, filter.model: 1, filter.cutoff: 4200Hz, filter.resonance: 0.3, filter.env.amount: 2.2, amp.attack: 0.002s, amp.decay: 0.18s, amp.sustain: 0.2, amp.release: 0.25s, voice.polyphony: 6, quality.oversampling: 1, output.gain: 0.2}
  effects:
    - delay: time_l=250ms, time_r=375ms, feedback=30%, mix=18%

@preset synth_brass
  source: builtin
  plugin: "builtin.open_synth"
  params: {synth_version: 2, osc.a.waveform: 1, osc.a.level: 0.6, osc.b.waveform: 1, osc.b.level: 0.25, osc.b.semitones: 12, unison.voices: 2, unison.detune: 7ct, unison.width: 0.5, filter.model: 1, filter.cutoff: 1900Hz, filter.resonance: 0.3, filter.drive: 0.2, filter.env.amount: 4.8, filter_env.attack: 0.02s, filter_env.decay: 0.35s, filter_env.sustain: 0.45, filter_env.release: 0.3s, amp.attack: 0.03s, amp.decay: 0.4s, amp.sustain: 0.6, amp.release: 0.35s, voice.polyphony: 6, quality.oversampling: 1, output.gain: 0.2}
  effects:
    - saturator: drive=10%, mix=20%

@preset synth_texture
  source: builtin
  plugin: "builtin.open_synth"
  params: {synth_version: 2, osc.a.waveform: 4, osc.a.wavetable_position: 0.82, osc.a.level: 0.45, osc.a.warp_mode: 16, osc.a.warp_amount: 0.4, osc.b.waveform: 0, osc.b.level: 0.22, osc.b.semitones: 7, noise.level: 0.08, unison.voices: 2, unison.detune: 12ct, unison.width: 0.75, filter.model: 0, filter.mode: 1, filter.cutoff: 2600Hz, filter.resonance: 0.35, amp.attack: 1.2s, amp.decay: 2s, amp.sustain: 0.7, amp.release: 2.5s, voice.polyphony: 6, quality.oversampling: 1, output.gain: 0.16}
  effects:
    - phaser: rate=0.16, depth=55%, feedback=38%, mix=20%

// ---------------------------------------------------------------------------
// SoundFont patches (GM programs; rendered through --soundfont)
// ---------------------------------------------------------------------------

@preset sf_piano
  source: soundfont
  program: 0

@preset sf_ep
  source: soundfont
  program: 4

@preset sf_guitar
  source: soundfont
  program: 24

@preset sf_bass
  source: soundfont
  program: 32

@preset sf_violin
  source: soundfont
  program: 40

@preset sf_strings
  source: soundfont
  program: 48

@preset sf_brass
  source: soundfont
  program: 61

@preset sf_flute
  source: soundfont
  program: 73

// ---------------------------------------------------------------------------
// Drum kits: 6 pads each, one velocity layer from the checked-in test tone
// ---------------------------------------------------------------------------

@kit kit_house
  max_voices: 32
  pad kick | gain: 12dB, tune: -24, decay: 0.32s, one_shot: true, choke: 1
  pad snare | gain: 8dB, tune: -5, decay: 0.22s, one_shot: true
  pad hat_closed | gain: 5dB, tune: 24, decay: 0.06s, one_shot: true, choke: 2
  pad hat_open | gain: 4dB, tune: 19, decay: 0.28s, one_shot: true, choke: 2
  pad clap | gain: 7dB, tune: 12, decay: 0.14s, one_shot: true
  pad crash | gain: 4dB, tune: 24, decay: 0.9s, one_shot: true
  layer kick | low: 1, high: 127, sample: "../crates/oc-engine/tests/fixtures/sampler/tone.flac"
  layer snare | low: 1, high: 127, sample: "../crates/oc-engine/tests/fixtures/sampler/tone.flac"
  layer hat_closed | low: 1, high: 127, sample: "../crates/oc-engine/tests/fixtures/sampler/tone.flac"
  layer hat_open | low: 1, high: 127, sample: "../crates/oc-engine/tests/fixtures/sampler/tone.flac"
  layer clap | low: 1, high: 127, sample: "../crates/oc-engine/tests/fixtures/sampler/tone.flac"
  layer crash | low: 1, high: 127, sample: "../crates/oc-engine/tests/fixtures/sampler/tone.flac"

@kit kit_break
  max_voices: 32
  pad kick | gain: 12dB, tune: -22, decay: 0.28s, one_shot: true, choke: 1
  pad snare | gain: 9dB, tune: -3, decay: 0.2s, one_shot: true
  pad hat_closed | gain: 5dB, tune: 22, decay: 0.05s, one_shot: true, choke: 2
  pad tom_low | gain: 8dB, tune: -14, decay: 0.34s, one_shot: true
  pad tom_high | gain: 8dB, tune: -7, decay: 0.22s, one_shot: true
  pad crash | gain: 4dB, tune: 21, decay: 0.8s, one_shot: true
  layer kick | low: 1, high: 127, sample: "../crates/oc-engine/tests/fixtures/sampler/tone.flac"
  layer snare | low: 1, high: 127, sample: "../crates/oc-engine/tests/fixtures/sampler/tone.flac"
  layer hat_closed | low: 1, high: 127, sample: "../crates/oc-engine/tests/fixtures/sampler/tone.flac"
  layer tom_low | low: 1, high: 127, sample: "../crates/oc-engine/tests/fixtures/sampler/tone.flac"
  layer tom_high | low: 1, high: 127, sample: "../crates/oc-engine/tests/fixtures/sampler/tone.flac"
  layer crash | low: 1, high: 127, sample: "../crates/oc-engine/tests/fixtures/sampler/tone.flac"

@kit kit_hats
  max_voices: 32
  pad hat_closed | gain: 5dB, tune: 24, decay: 0.05s, one_shot: true, choke: 2
  pad hat_open | gain: 4dB, tune: 17, decay: 0.24s, one_shot: true, choke: 2
  pad shaker | gain: 3dB, tune: 26, decay: 0.04s, one_shot: true
  pad rim | gain: 7dB, tune: 19, decay: 0.06s, one_shot: true
  pad clap | gain: 6dB, tune: 14, decay: 0.12s, one_shot: true
  pad crash | gain: 3dB, tune: 24, decay: 0.7s, one_shot: true
  layer hat_closed | low: 1, high: 127, sample: "../crates/oc-engine/tests/fixtures/sampler/tone.flac"
  layer hat_open | low: 1, high: 127, sample: "../crates/oc-engine/tests/fixtures/sampler/tone.flac"
  layer shaker | low: 1, high: 127, sample: "../crates/oc-engine/tests/fixtures/sampler/tone.flac", gain: -6dB
  layer rim | low: 1, high: 127, sample: "../crates/oc-engine/tests/fixtures/sampler/tone.flac"
  layer clap | low: 1, high: 127, sample: "../crates/oc-engine/tests/fixtures/sampler/tone.flac"
  layer crash | low: 1, high: 127, sample: "../crates/oc-engine/tests/fixtures/sampler/tone.flac"

@kit kit_perc
  max_voices: 24
  pad kick | gain: 11dB, tune: -25, decay: 0.26s, one_shot: true, choke: 1
  pad snare | gain: 8dB, tune: -2, decay: 0.18s, one_shot: true
  pad tom_low | gain: 8dB, tune: -16, decay: 0.3s, one_shot: true
  pad tom_high | gain: 8dB, tune: -8, decay: 0.2s, one_shot: true
  pad crash | gain: 3dB, tune: 23, decay: 0.65s, one_shot: true
  pad rim | gain: 7dB, tune: 20, decay: 0.05s, one_shot: true
  layer kick | low: 1, high: 127, sample: "../crates/oc-engine/tests/fixtures/sampler/tone.flac"
  layer snare | low: 1, high: 127, sample: "../crates/oc-engine/tests/fixtures/sampler/tone.flac"
  layer tom_low | low: 1, high: 127, sample: "../crates/oc-engine/tests/fixtures/sampler/tone.flac"
  layer tom_high | low: 1, high: 127, sample: "../crates/oc-engine/tests/fixtures/sampler/tone.flac"
  layer crash | low: 1, high: 127, sample: "../crates/oc-engine/tests/fixtures/sampler/tone.flac"
  layer rim | low: 1, high: 127, sample: "../crates/oc-engine/tests/fixtures/sampler/tone.flac"

// ---------------------------------------------------------------------------
// Patterns
// ---------------------------------------------------------------------------

@pattern pad_chords
  events:
    @0 C3 w mp
    @0 Eb3 w mp
    @0 G3 w mp
    @4 Ab2 w mp
    @4 C3 w mp
    @4 Eb3 w mp
    @8 Eb3 w mp
    @8 G3 w mp
    @8 Bb3 w mp
    @12 Bb2 w mp
    @12 D3 w mp
    @12 F3 w mp
    @16 F2 w mp
    @16 Ab2 w mp
    @16 C3 w mp
    @20 Db3 w mp
    @20 F3 w mp
    @20 Ab3 w mp
    @24 G2 w mp
    @24 B3 w mp
    @24 D3 w mp
    @28 C3 w mf
    @28 Eb3 w mf
    @28 G3 w mf

@pattern lead_line
  events:
    C5 q mf
    G4 8th mp
    Eb5 8th mf
    G4 q mp
    Bb4 q mf
    |
    Bb4 q mf
    F4 8th mp
    D5 8th mf
    F4 q mp
    Ab4 q mf
    |
    Eb5 q f
    Bb4 8th mf
    G4 8th mp
    Bb4 q mf
    C5 q f
    |
    C5 h f vibrato={rate: 5Hz, depth: 18ct, delay: 0.2s}
    G4 q mp
    rest q
    |
    Ab4 q mf
    Eb5 8th f
    C5 8th mf
    Ab4 q mp
    Eb5 q f
    |
    Db5 q f
    Ab4 8th mf
    F4 8th mp
    Db5 q mf
    F5 q f
    |
    D5 q f
    B4 8th mf
    G4 8th mp
    D5 q mf
    G5 q f
    |
    C5 h. f vibrato={rate: 5.5Hz, depth: 22ct, delay: 0.15s}
    Eb5 q f

