// ---------------------------------------------------------------------------
// Buses and master
// ---------------------------------------------------------------------------

@bus drum_bus
  mix: vol=-5dB
  routes: [master]
  effects:
    - compression: threshold=-16dB, ratio=3:1, attack=8ms, release=120ms, knee=6dB, makeup=2dB, mix=100%
    - eq: low_freq=90Hz, low_gain=1.5dB, mid_freq=400Hz, mid_gain=-1.5dB, q=1.1, high_freq=7500Hz, high_gain=1dB
    - saturator: drive=18%, mix=30%
    - delay: time_l=280ms, time_r=420ms, feedback=22%, mix=12%

@bus music_bus
  mix: vol=-6dB
  routes: [master]
  effects:
    - compression: threshold=-18dB, ratio=2.5:1, attack=12ms, release=180ms, knee=6dB, makeup=2.5dB, mix=100%
    - eq: low_freq=140Hz, low_gain=-2dB, mid_freq=900Hz, mid_gain=1.5dB, q=1.2, high_freq=8500Hz, high_gain=-1.5dB
    - saturator: drive=12%, mix=22%
    - delay: time_l=310ms, time_r=465ms, feedback=24%, mix=20%

@bus inst_bus
  mix: vol=-6dB
  routes: [master]
  effects:
    - compression: threshold=-20dB, ratio=2:1, attack=18ms, release=200ms, knee=8dB, makeup=3dB, mix=100%
    - eq: low_freq=120Hz, low_gain=1dB, mid_freq=900Hz, mid_gain=-1dB, q=1.0, high_freq=9000Hz, high_gain=1dB
    - saturator: drive=10%, mix=18%
    - reverb: decay=2.6s, predelay=28ms, damping=48%, mix=24%, low_cut=160Hz, high_cut=8500Hz

@bus space_bus
  mix: vol=-9dB
  routes: [master]
  effects:
    - compression: threshold=-22dB, ratio=1.8:1, attack=25ms, release=240ms, knee=8dB, makeup=3dB, mix=100%
    - eq: low_freq=200Hz, low_gain=-3dB, mid_freq=1200Hz, mid_gain=1dB, q=1.0, high_freq=9000Hz, high_gain=-1dB
    - saturator: drive=8%, mix=15%
    - delay: time_l=420ms, time_r=630ms, feedback=32%, mix=22%

@master
  volume: -1dB
  loudness: -14dB
  effects:
    - compression: threshold=-10dB, ratio=2.5:1, attack=8ms, release=140ms, knee=6dB, makeup=1.5dB, mix=100%
    - limiter: ceiling=-1dB, release=100ms, lookahead=8ms, true_peak=true, oversampling=4x

@section full [1:1 - 33:1]
  label: "Reference 32 bars"
