@pattern violin_line
  events:
    @0 C5 h. mf vibrato={rate: 4.8Hz, depth: 16ct, delay: 0.25s}
    @3 G4 q mp
    @4 Ab4 h. mf vibrato={rate: 5Hz, depth: 18ct, delay: 0.2s}
    @7 Eb4 q mp
    @8 Bb4 h. mf vibrato={rate: 5.2Hz, depth: 17ct, delay: 0.22s}
    @11 F4 q mp
    @12 D5 h. f vibrato={rate: 5.1Hz, depth: 20ct, delay: 0.18s}
    @15 Bb4 q mp
    @16 C5 h. mf vibrato={rate: 4.9Hz, depth: 18ct, delay: 0.24s}
    @19 Ab4 q mp
    @20 Db5 h. f vibrato={rate: 5.3Hz, depth: 20ct, delay: 0.18s}
    @23 Ab4 q mp
    @24 G4 h. mf vibrato={rate: 5Hz, depth: 16ct, delay: 0.22s}
    @27 D5 q mp
    @28 C5 w f vibrato={rate: 5.4Hz, depth: 22ct, delay: 0.15s}

@pattern drum_house
  hits:
    kick 1:0 ff
    hat_closed 1:0 mp
    hat_closed 1:1 mp
    hat_open 1:2 mf
    hat_closed 1:3 mp
    kick 2:0 f
    clap 2:0 f
    hat_closed 2:1 mp
    hat_closed 2:2 mf
    hat_closed 2:3 mp
    kick 3:0 f
    hat_closed 3:0 mp
    hat_closed 3:1 mp
    hat_open 3:2 mf
    hat_closed 3:3 mp
    kick 4:0 ff
    snare 4:0 ff
    hat_closed 4:1 mp
    crash 4:2 mf

@pattern drum_break
  hits:
    kick 1:0 ff
    hat_closed 1:0 mp
    snare 1:2 f
    hat_closed 1:2 mp
    kick 1:3 mf
    hat_closed 1:3 mp
    kick 2:0 f
    hat_closed 2:0 mp
    snare 2:2 ff
    hat_closed 2:2 mp
    tom_low 2:3 mf
    kick 3:0 f
    hat_closed 3:0 mp
    snare 3:1 f
    hat_closed 3:1 mp
    kick 3:2 mf
    hat_closed 3:2 mp
    snare 3:3 mf
    hat_closed 3:3 mp
    kick 4:0 ff
    snare 4:0 ff
    tom_high 4:2 mf
    crash 4:2 f
    tom_low 4:3 f

@pattern drum_hats
  hits:
    hat_closed 1:0 mf
    shaker 1:0 mp
    hat_closed 1:1 mp
    shaker 1:1 mp
    hat_closed 1:2 mf
    shaker 1:2 mp
    hat_open 1:3 mf
    hat_closed 2:0 mf
    shaker 2:0 mp
    hat_closed 2:1 mp
    shaker 2:1 mp
    rim 2:2 mf
    hat_closed 2:2 mf
    shaker 2:2 mp
    hat_closed 2:3 mp
    shaker 2:3 mp
    hat_closed 3:0 mf
    shaker 3:0 mp
    hat_closed 3:1 mp
    shaker 3:1 mp
    hat_closed 3:2 mf
    shaker 3:2 mp
    hat_open 3:3 mf
    hat_closed 4:0 mf
    shaker 4:0 mp
    hat_closed 4:1 mp
    clap 4:2 f
    crash 4:2 mf
    hat_closed 4:3 mp

@pattern drum_perc
  hits:
    kick 1:0 ff
    rim 1:1 mf
    tom_high 1:2 mf
    kick 1:3 f
    tom_low 2:0 f
    snare 2:1 mf
    rim 2:2 mf
    tom_high 2:3 f
    kick 3:0 f
    tom_low 3:1 mf
    snare 3:2 f
    tom_high 3:3 mf
    kick 4:0 ff
    crash 4:0 f
    tom_low 4:2 f
    rim 4:3 mf

